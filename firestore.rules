rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSharedLedger(ledgerId) {
      return ledgerId == 'dain_yongin_shared';
    }

    function isStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.uid == userId;
    }

    function isValidSharedWorkspace(data, ledgerId) {
      return data.keys().hasAll([
          'id',
          'siteName',
          'favoritePinnedKeys',
          'favoriteMutedAutoKeys',
          'sheetOrder',
          'migratedFromLegacy',
          'lastMigrationId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'siteName',
          'favoritePinnedKeys',
          'favoriteMutedAutoKeys',
          'sheetOrder',
          'migratedFromLegacy',
          'lastMigrationId',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id) && data.id == ledgerId && isSharedLedger(ledgerId)
        && data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 200
        && isStringList(data.favoritePinnedKeys, 500)
        && isStringList(data.favoriteMutedAutoKeys, 500)
        && isStringList(data.sheetOrder, 100)
        && data.migratedFromLegacy is bool
        && data.lastMigrationId is string && data.lastMigrationId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSharedSheet(data, ledgerId, sheetId) {
      return data.keys().hasAll(['id', 'ledgerId', 'name', 'subtitle', 'orderIndex', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ledgerId', 'name', 'subtitle', 'orderIndex', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == sheetId
        && isValidId(data.ledgerId) && data.ledgerId == ledgerId && isSharedLedger(ledgerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.subtitle is string && data.subtitle.size() <= 300
        && (data.orderIndex is int || data.orderIndex is float) && data.orderIndex >= 0 && data.orderIndex <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSharedItem(data, ledgerId, itemId) {
      return data.keys().hasAll([
          'id',
          'ledgerId',
          'sheetId',
          'orderIndex',
          'name',
          'supplier',
          'spec',
          'unit',
          'quantity',
          'packQty',
          'subUnit',
          'isCompleted',
          'location',
          'remarks',
          'date',
          'clientCreatedAt',
          'slipIds',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ledgerId',
          'sheetId',
          'orderIndex',
          'name',
          'supplier',
          'spec',
          'unit',
          'quantity',
          'packQty',
          'subUnit',
          'isCompleted',
          'location',
          'remarks',
          'date',
          'clientCreatedAt',
          'slipIds',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id) && data.id == itemId
        && isValidId(data.ledgerId) && data.ledgerId == ledgerId && isSharedLedger(ledgerId)
        && isValidId(data.sheetId)
        && (data.orderIndex is int || data.orderIndex is float) && data.orderIndex >= 0 && data.orderIndex <= 100000
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 300
        && data.supplier is string && data.supplier.size() <= 200
        && data.spec is string && data.spec.size() <= 300
        && data.unit is string && data.unit.size() <= 50
        && (data.quantity is int || data.quantity is float) && data.quantity >= 0 && data.quantity <= 100000000
        && (data.packQty is int || data.packQty is float) && data.packQty >= 0 && data.packQty <= 1000000
        && data.subUnit is string && data.subUnit.size() <= 50
        && data.isCompleted is bool
        && data.location is string && data.location.size() <= 200
        && data.remarks is string && data.remarks.size() <= 1000
        && data.date is string && data.date.size() <= 32
        && (data.clientCreatedAt is int || data.clientCreatedAt is float) && data.clientCreatedAt >= 0
        && isStringList(data.slipIds, 30)
        && (data.revision is int || data.revision is float) && data.revision >= 1 && data.revision <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSharedSlip(data, ledgerId, slipId) {
      return data.keys().hasAll([
          'id',
          'ledgerId',
          'title',
          'documentType',
          'supplierName',
          'documentDate',
          'receiverName',
          'totalAmount',
          'notes',
          'sheetId',
          'sheetName',
          'itemIds',
          'itemNames',
          'imageUrl',
          'storagePath',
          'fileName',
          'fileSize',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ledgerId',
          'title',
          'documentType',
          'supplierName',
          'documentDate',
          'receiverName',
          'totalAmount',
          'notes',
          'sheetId',
          'sheetName',
          'itemIds',
          'itemNames',
          'imageUrl',
          'storagePath',
          'fileName',
          'fileSize',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id) && data.id == slipId
        && isValidId(data.ledgerId) && data.ledgerId == ledgerId && isSharedLedger(ledgerId)
        && data.title is string && data.title.size() <= 300
        && data.documentType is string && data.documentType.size() <= 100
        && data.supplierName is string && data.supplierName.size() <= 200
        && data.documentDate is string && data.documentDate.size() <= 32
        && data.receiverName is string && data.receiverName.size() <= 200
        && (data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0
        && data.notes is string && data.notes.size() <= 2000
        && data.sheetId is string && data.sheetId.size() <= 128
        && data.sheetName is string && data.sheetName.size() <= 200
        && isStringList(data.itemIds, 500)
        && isStringList(data.itemNames, 500)
        && data.imageUrl is string && data.imageUrl.size() <= 500000
        && data.storagePath is string && data.storagePath.size() <= 500
        && data.fileName is string && data.fileName.size() <= 300
        && (data.fileSize is int || data.fileSize is float) && data.fileSize >= 0
        && (data.clientCreatedAt is int || data.clientCreatedAt is float) && data.clientCreatedAt >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMigrationRecord(data, ledgerId, migrationId) {
      return data.keys().hasAll([
          'id',
          'ledgerId',
          'sourceType',
          'sourceLabel',
          'backupTimestamp',
          'sheetsCount',
          'itemsCount',
          'slipsCount',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ledgerId',
          'sourceType',
          'sourceLabel',
          'backupTimestamp',
          'sheetsCount',
          'itemsCount',
          'slipsCount',
          'createdAt'
        ])
        && isValidId(data.id) && data.id == migrationId
        && isValidId(data.ledgerId) && data.ledgerId == ledgerId && isSharedLedger(ledgerId)
        && data.sourceType in ['local_storage', 'legacy_uid', 'json_backup', 'fresh_seed']
        && data.sourceLabel is string && data.sourceLabel.size() >= 1 && data.sourceLabel.size() <= 200
        && data.backupTimestamp is string && data.backupTimestamp.size() <= 64
        && (data.sheetsCount is int || data.sheetsCount is float) && data.sheetsCount >= 0
        && (data.itemsCount is int || data.itemsCount is float) && data.itemsCount >= 0
        && (data.slipsCount is int || data.slipsCount is float) && data.slipsCount >= 0
        && data.createdAt is timestamp;
    }

    // Shared company ledger (strictly scoped to ledgerId == 'dain_yongin_shared')
    // Anyone who has the app link can read & collaboratively edit validated ledger entities.
    match /ledgers/{ledgerId} {
      allow get: if isSharedLedger(ledgerId);
      allow list: if false;
      allow create: if isSharedLedger(ledgerId)
        && isValidSharedWorkspace(incoming(), ledgerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSharedLedger(ledgerId)
        && isValidSharedWorkspace(incoming(), ledgerId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'siteName',
          'favoritePinnedKeys',
          'favoriteMutedAutoKeys',
          'sheetOrder',
          'migratedFromLegacy',
          'lastMigrationId',
          'updatedAt'
        ]);
      allow delete: if false;

      match /sheets/{sheetId} {
        allow get: if isSharedLedger(ledgerId) && isValidId(sheetId);
        allow list: if isSharedLedger(ledgerId) && resource.data.ledgerId == 'dain_yongin_shared';
        allow create: if isSharedLedger(ledgerId)
          && isValidId(sheetId)
          && isValidSharedSheet(incoming(), ledgerId, sheetId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/ledgers/$(ledgerId));
        allow update: if isSharedLedger(ledgerId)
          && isValidId(sheetId)
          && isValidSharedSheet(incoming(), ledgerId, sheetId)
          && incoming().id == existing().id
          && incoming().ledgerId == existing().ledgerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'subtitle',
            'orderIndex',
            'updatedAt'
          ]);
        allow delete: if isSharedLedger(ledgerId) && isValidId(sheetId);
      }

      match /items/{itemId} {
        allow get: if isSharedLedger(ledgerId) && isValidId(itemId);
        allow list: if isSharedLedger(ledgerId) && resource.data.ledgerId == 'dain_yongin_shared';
        allow create: if isSharedLedger(ledgerId)
          && isValidId(itemId)
          && isValidSharedItem(incoming(), ledgerId, itemId)
          && incoming().revision == 1
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/ledgers/$(ledgerId)/sheets/$(incoming().sheetId));
        allow update: if isSharedLedger(ledgerId)
          && isValidId(itemId)
          && isValidSharedItem(incoming(), ledgerId, itemId)
          && incoming().id == existing().id
          && incoming().ledgerId == existing().ledgerId
          && incoming().clientCreatedAt == existing().clientCreatedAt
          && incoming().createdAt == existing().createdAt
          && incoming().revision == existing().revision + 1
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sheetId',
            'orderIndex',
            'name',
            'supplier',
            'spec',
            'unit',
            'quantity',
            'packQty',
            'subUnit',
            'isCompleted',
            'location',
            'remarks',
            'date',
            'slipIds',
            'revision',
            'updatedAt'
          ])
          && existsAfter(/databases/$(database)/documents/ledgers/$(ledgerId)/sheets/$(incoming().sheetId));
        allow delete: if isSharedLedger(ledgerId) && isValidId(itemId);
      }

      match /slips/{slipId} {
        allow get: if isSharedLedger(ledgerId) && isValidId(slipId);
        allow list: if isSharedLedger(ledgerId) && resource.data.ledgerId == 'dain_yongin_shared';
        allow create: if isSharedLedger(ledgerId)
          && isValidId(slipId)
          && isValidSharedSlip(incoming(), ledgerId, slipId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/ledgers/$(ledgerId));
        allow update: if isSharedLedger(ledgerId)
          && isValidId(slipId)
          && isValidSharedSlip(incoming(), ledgerId, slipId)
          && incoming().id == existing().id
          && incoming().ledgerId == existing().ledgerId
          && incoming().clientCreatedAt == existing().clientCreatedAt
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'documentType',
            'supplierName',
            'documentDate',
            'receiverName',
            'totalAmount',
            'notes',
            'sheetId',
            'sheetName',
            'itemIds',
            'itemNames',
            'imageUrl',
            'storagePath',
            'fileName',
            'fileSize',
            'updatedAt'
          ]);
        allow delete: if isSharedLedger(ledgerId) && isValidId(slipId);
      }

      match /migrations/{migrationId} {
        allow get: if isSharedLedger(ledgerId) && isValidId(migrationId);
        allow list: if isSharedLedger(ledgerId) && resource.data.ledgerId == 'dain_yongin_shared';
        allow create: if isSharedLedger(ledgerId)
          && isValidId(migrationId)
          && isValidMigrationRecord(incoming(), ledgerId, migrationId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/ledgers/$(ledgerId));
        allow update, delete: if false;
      }
    }

    // Legacy private per-user collections remain strictly owner-only read-only for one-time migration
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list, create, update, delete: if false;

      match /sheets/{sheetId} {
        allow get: if isValidId(userId) && isValidId(sheetId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;
        allow create, update, delete: if false;
      }

      match /items/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;
        allow create, update, delete: if false;
      }

      match /slips/{slipId} {
        allow get: if isValidId(userId) && isValidId(slipId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;
        allow create, update, delete: if false;
      }
    }
  }
}
