{
  "entities": {
    "SharedLedgerWorkspace": {
      "title": "SharedLedgerWorkspace",
      "description": "Shared company ledger settings, site metadata, sheet ordering, favorites, and migration flag",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "siteName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "favoritePinnedKeys": {
          "type": "array",
          "description": "Manually starred material keys (name||spec)"
        },
        "favoriteMutedAutoKeys": {
          "type": "array",
          "description": "Auto-favorited material keys explicitly muted"
        },
        "sheetOrder": {
          "type": "array",
          "description": "Ordered list of sheet IDs"
        },
        "migratedFromLegacy": {
          "type": "boolean"
        },
        "lastMigrationId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "siteName",
        "favoritePinnedKeys",
        "favoriteMutedAutoKeys",
        "sheetOrder",
        "migratedFromLegacy",
        "lastMigrationId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedMaterialSheet": {
      "title": "SharedMaterialSheet",
      "description": "A shared material ledger sheet tab",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "maxLength": 300
        },
        "orderIndex": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ledgerId",
        "name",
        "subtitle",
        "orderIndex",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedMaterialItem": {
      "title": "SharedMaterialItem",
      "description": "An individual inbound/outbound material item with revision-guarded concurrency",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "supplier": {
          "type": "string",
          "maxLength": 200
        },
        "spec": {
          "type": "string",
          "maxLength": 300
        },
        "unit": {
          "type": "string",
          "maxLength": 50
        },
        "quantity": {
          "type": "number"
        },
        "packQty": {
          "type": "number"
        },
        "subUnit": {
          "type": "string",
          "maxLength": 50
        },
        "isCompleted": {
          "type": "boolean"
        },
        "location": {
          "type": "string",
          "maxLength": 200
        },
        "remarks": {
          "type": "string",
          "maxLength": 1000
        },
        "date": {
          "type": "string",
          "maxLength": 32
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "slipIds": {
          "type": "array",
          "description": "Linked receipt slip IDs"
        },
        "revision": {
          "type": "number",
          "description": "Monotonic optimistic concurrency revision starting at 1"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ledgerId",
        "sheetId",
        "orderIndex",
        "name",
        "supplier",
        "spec",
        "unit",
        "quantity",
        "packQty",
        "subUnit",
        "isCompleted",
        "location",
        "remarks",
        "date",
        "clientCreatedAt",
        "slipIds",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedReceiptSlip": {
      "title": "SharedReceiptSlip",
      "description": "Metadata for an uploaded delivery slip or invoice in the shared Firebase Storage path",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "documentType": {
          "type": "string",
          "maxLength": 100
        },
        "supplierName": {
          "type": "string",
          "maxLength": 200
        },
        "documentDate": {
          "type": "string",
          "maxLength": 32
        },
        "receiverName": {
          "type": "string",
          "maxLength": 200
        },
        "totalAmount": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "sheetId": {
          "type": "string",
          "maxLength": 128
        },
        "sheetName": {
          "type": "string",
          "maxLength": 200
        },
        "itemIds": {
          "type": "array"
        },
        "itemNames": {
          "type": "array"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500000
        },
        "storagePath": {
          "type": "string",
          "maxLength": 500
        },
        "fileName": {
          "type": "string",
          "maxLength": 300
        },
        "fileSize": {
          "type": "number"
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ledgerId",
        "title",
        "documentType",
        "supplierName",
        "documentDate",
        "receiverName",
        "totalAmount",
        "notes",
        "sheetId",
        "sheetName",
        "itemIds",
        "itemNames",
        "imageUrl",
        "storagePath",
        "fileName",
        "fileSize",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "MigrationRecord": {
      "title": "MigrationRecord",
      "description": "Immutable audit record preventing duplicate one-time migrations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourceType": {
          "type": "string",
          "enum": ["local_storage", "legacy_uid", "json_backup", "fresh_seed"]
        },
        "sourceLabel": {
          "type": "string",
          "maxLength": 200
        },
        "backupTimestamp": {
          "type": "string",
          "maxLength": 64
        },
        "sheetsCount": {
          "type": "number"
        },
        "itemsCount": {
          "type": "number"
        },
        "slipsCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ledgerId",
        "sourceType",
        "sourceLabel",
        "backupTimestamp",
        "sheetsCount",
        "itemsCount",
        "slipsCount",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/ledgers/{ledgerId}": {
      "schema": {
        "$ref": "#/entities/SharedLedgerWorkspace"
      },
      "description": "Shared company ledger workspace document (restricted to dain_yongin_shared)"
    },
    "/ledgers/{ledgerId}/sheets/{sheetId}": {
      "schema": {
        "$ref": "#/entities/SharedMaterialSheet"
      },
      "description": "Shared material ledger sheets"
    },
    "/ledgers/{ledgerId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/SharedMaterialItem"
      },
      "description": "Shared material ledger items with per-item revision control"
    },
    "/ledgers/{ledgerId}/slips/{slipId}": {
      "schema": {
        "$ref": "#/entities/SharedReceiptSlip"
      },
      "description": "Shared receipt slip records pointing to Firebase Storage"
    },
    "/ledgers/{ledgerId}/migrations/{migrationId}": {
      "schema": {
        "$ref": "#/entities/MigrationRecord"
      },
      "description": "Immutable one-time migration lock records"
    }
  }
}
